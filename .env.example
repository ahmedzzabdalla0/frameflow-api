NODE_ENV=development
PORT=3568

POSTGRES_USER=frameflow
POSTGRES_PASSWORD=frameflow
POSTGRES_DB=frameflow

DATABASE_URL=postgresql://frameflow:frameflow@localhost:5433/frameflow?schema=public

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

UPLOADS_DIR=./storage/uploads
THUMBS_DIR=./storage/thumbs
VIDEO_EXTENSIONS=.mp4,.mov,.webm,.m4v,.mkv

CORS_ORIGIN=*

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
